# Autograde AI — environment template.
# Copy to .env and fill local secrets. .env is gitignored; never commit real secrets.

# Core
AUTOGRADE_ENV=dev
AUTOGRADE_LOG_LEVEL=INFO

# Postgres
POSTGRES_HOST=localhost
# Host port is 5433 to avoid clashing with a local Postgres on 5432.
POSTGRES_PORT=5433
POSTGRES_DB=autograde
POSTGRES_USER=autograde
POSTGRES_PASSWORD=change_me_locally
# 32-byte secret used to HMAC student identifiers into student_hash.
STUDENT_HASH_SECRET=change_me_locally_32_bytes______

# Kafka (Redpanda in dev)
KAFKA_BROKERS=localhost:9092

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=autograde
MINIO_SECRET_KEY=change_me_locally
MINIO_BUCKET_PREFIX=autograde-

# Qdrant
QDRANT_URL=http://localhost:6333

# Temporal
TEMPORAL_ADDRESS=localhost:7233

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# LLM
LLM_BACKEND=local                     # or "anthropic", "openai"
OLLAMA_URL=http://localhost:11434
LOCAL_MODEL_THEORY=qwen2.5:32b-instruct
LOCAL_MODEL_CODE=qwen2.5-coder:32b

# Optional (paid tier; disabled by default)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
