{
  "title": "Autograde AI — Graders",
  "uid": "autograde-graders",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Grader activity latency P50 (ms)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "histogram_quantile(0.5, sum(rate(autograde_grader_duration_milliseconds_bucket[5m])) by (le, grader))",
        "legendFormat": "{{grader}}"
      }]
    },
    {
      "id": 2, "type": "timeseries", "title": "Grader activity latency P99 (ms)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "histogram_quantile(0.99, sum(rate(autograde_grader_duration_milliseconds_bucket[5m])) by (le, grader))",
        "legendFormat": "{{grader}}"
      }]
    },
    {
      "id": 3, "type": "timeseries", "title": "Grading throughput (activities/min)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum(rate(autograde_grader_duration_milliseconds_count[5m])) by (grader) * 60",
        "legendFormat": "{{grader}}"
      }]
    },
    {
      "id": 4, "type": "timeseries", "title": "Collector: accepted spans/min (pipeline liveness)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum(rate(otelcol_receiver_accepted_spans_total[5m])) * 60",
        "legendFormat": "spans/min"
      }]
    }
  ]
}
